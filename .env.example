# Database Configuration (PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=threat_monitoring_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/threat_monitoring_db

# Geocoding & Maps API
GEOCODING_API_KEY=your_geocoding_api_key_here

# Scraper Configuration & Credentials
SCRAPER_INTERVAL_SECONDS=3600
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)
X_API_BEARER_TOKEN=your_x_api_bearer_token_here
NEWS_API_KEY=your_news_api_key_here

# NLP Spacy Model
SPACY_MODEL=xx_ent_wiki_sm
